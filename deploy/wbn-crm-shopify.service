[Unit]
Description=WBN CRM Shopify employee sales synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wbncrm
Group=wbncrm
WorkingDirectory=/opt/wbn-crm/current
EnvironmentFile=/etc/wbn-crm.env
ExecStart=/opt/wbn-crm/venv/bin/python sync_shopify.py --rolling-days 45
Nice=5

