[Unit]
Description=WBN CRM Uniware order-status synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wbncrm
Group=wbncrm
WorkingDirectory=/opt/wbn-crm/current
EnvironmentFile=/etc/wbn-crm.env
ExecStart=/opt/wbn-crm/venv/bin/python sync_uniware.py
Nice=5

